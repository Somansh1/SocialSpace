{
  "name": "socialspace",
  "version": "1.0.0",
  "private": true,
  "description": "A private table for two: talk, chat, draw and watch together.",
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --experimental-https",
    "build": "next build",
    "start": "next start",
    "relay": "node server.js",
    "typecheck": "tsc --noEmit",
    "check:relay": "node scripts/relay-check.js",
    "check:url": "node --no-warnings scripts/url-check.mts",
    "check": "npm run check:url && npm run check:relay"
  },
  "dependencies": {
    "@radix-ui/react-toast": "1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "next": "15.5.27",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5"
  }
}
