# WebSocket relay the browser connects to. Read at BUILD time (NEXT_PUBLIC_ values are baked into the page).
# Local relay:  ws://localhost:8080      Hosted relay:  wss://your-relay.example.com   (an https site needs wss://)
NEXT_PUBLIC_BACKEND_URL=ws://localhost:8080

# Public address of the deployed interface, used for the share image and link previews.
# If unset, the host's production-URL variable is used when present, otherwise http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
